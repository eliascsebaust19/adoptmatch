# Edge Function secrets. `supabase functions serve --env-file .env` locally;
# `supabase secrets set --env-file .env.production` on the hosted project.

# Injected automatically on hosted Supabase, required locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
PAYMENT_CALLBACK_BASE=http://127.0.0.1:54321/functions/v1/payments
PAYMENT_RETURN_URL=https://adoptmatch.app/payments/result

# Push (FCM HTTP v1 service account, JSON on one line)
FCM_SERVICE_ACCOUNT_JSON=
