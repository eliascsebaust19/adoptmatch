APP_NAME=AdoptMatchAPI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://adoptmatch-api.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Clever Cloud MySQL Relational Database Configuration
# Copy values from Clever Cloud MySQL add-on dashboard
DB_CONNECTION=mysql
DB_HOST=bxxxxxxxxxxxxxx-mysql.services.clever-cloud.com
DB_PORT=3306
DB_DATABASE=bxxxxxxxxxxxxxx
DB_USERNAME=uxxxxxxxxxxxxxx
DB_PASSWORD=pxxxxxxxxxxxxxx

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Gemini AI Key
GEMINI_API_KEY=

# Google OAuth Identity Client (For verifying Flutter Google Sign-In idTokens)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Cloudinary Multi-Image Storage CDN (Optional)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Vercel Blob High-Speed Storage CDN
BLOB_READ_WRITE_TOKEN=your_vercel_blob_rw_token_here
VERCEL_BLOB_STORE_ID=3kHT7mDTcvdaG9fF

# Laravel Sanctum Stateful Domains
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

