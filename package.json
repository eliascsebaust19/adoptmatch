{
  "name": "adoptmatch",
  "version": "2.0.0",
  "description": "AdoptMatch - AI-Powered Pet Adoption & Matching Platform (Flutter + Supabase + Python AI Service)",
  "private": true,
  "scripts": {
    "start:ai": "cd ai-service && python -m uvicorn app.main:app --reload --port 8000",
    "test:ai": "python -m pytest ai-service/tests",
    "test:flutter": "flutter test",
    "analyze:flutter": "flutter analyze --no-fatal-infos",
    "bootstrap:admin": "node supabase-edition/scripts/bootstrap-admin.mjs",
    "db:push": "cd supabase-edition && supabase db push",
    "test:db": "cd supabase-edition && supabase test db"
  },
  "keywords": [
    "pet-adoption",
    "ai-matching",
    "flutter",
    "supabase",
    "fastapi",
    "edge-functions"
  ],
  "author": "AdoptMatch Team",
  "license": "UNLICENSED"
}
