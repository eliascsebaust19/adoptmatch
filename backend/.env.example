# AdoptMatch - Backend Environment Variables Configuration Template
# Copy this file to .env and configure your secrets

PORT=5000
NODE_ENV=development

# Durable SQLite database. Production requires an explicit persistent path.
# Run exactly one API process per database file.
DATABASE_PATH=./data/adoptmatch.sqlite

# JSON Web Token Secret for Session Signing
# Production requires at least 32 random characters. Never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth Credentials (From Google Cloud Console: APIs & Services -> Credentials)
# Must equal the Web OAuth client ID the Flutter app uses (GOOGLE_CLIENT_ID dart-define).
GOOGLE_CLIENT_ID=
# Optional extra audiences (iOS/Android client IDs), comma separated.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vercel Blob Storage Token (server-side only; never ship this to clients)
# Rotate the credential in the Vercel dashboard if it was ever committed; keep it out of source control.
BLOB_READ_WRITE_TOKEN=

# SSLCommerz Payment Gateway Configuration (BDT Payments & bKash Channel)
# For Sandbox testing: register at https://developer.sslcommerz.com/
# Set SSLCOMMERZ_IS_LIVE=true when using live merchant credentials
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Official bKash Number for Direct/Manual Payment Support (Displayed with Copy button)
BKASH_OFFICIAL_NUMBER=

# Public Server URL & App Deep Link (Used for SSLCommerz callback redirects)
BACKEND_BASE_URL=http://localhost:5000
APP_DEEP_LINK_SCHEME=adoptmatch://payment-callback



# Explicit opt-in for local payment simulation only. Never enable in production/live mode.
ENABLE_PAYMENT_SIMULATOR=false
# Required only for the non-production test-token endpoint.
TEST_AUTH_SECRET=
